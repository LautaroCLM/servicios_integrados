# API Proxy para Netlify Functions
/api/contact                  /.netlify/functions/contact   200!
/api/ai-chat                  /.netlify/functions/ai-chat   200!
/api/admin-novedades          /.netlify/functions/admin-novedades 200!
/api/admin-novedades/*        /.netlify/functions/admin-novedades 200!

# Redirección canónica 301 directa para evitar cadenas
/politica-de-privacidad       /privacidad/                  301!
/politica-de-privacidad/      /privacidad/                  301!

# Panel admin SPA
/panel-novedades-gestion-si   /index.html                   200
/panel-novedades-gestion-si/* /index.html                   200

# 404 personalizado para rutas inexistentes
/*                            /404.html                     404
