# =============================================================================
# VARIABLES DE ENTORNO — SERVICIOS INTEGRADOS
# =============================================================================

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Entorno de ejecución (development / production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE ENVÍO DE EMAILS (SMTP / NODEMAILER)
# -----------------------------------------------------------------------------
# Si estas variables no están configuradas, en desarrollo (NODE_ENV=development) las
# consultas se muestran en la consola. En producción el formulario devuelve error
# (para no perder consultas en silencio). ALLOW_EMAIL_SIMULATION=true fuerza la simulación.

# Servidor SMTP (Ejemplos: smtp.gmail.com, smtp.hostinger.com, smtp.office365.com, etc.)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (465 para SSL/TLS directo, 587 para STARTTLS)
SMTP_PORT=587

# Usar SSL directo (true para puerto 465, false para puerto 587)
SMTP_SECURE=false

# Usuario / Dirección de correo del remitente SMTP
SMTP_USER=antonioa@serviciosintegradosweb.com

# Contraseña de la cuenta o Contraseña de Aplicación (ej. Google App Password o clave SMTP)
SMTP_PASS=tu_contraseña_o_app_password

# Destinatario de las consultas recibidas (por defecto: antonioa@serviciosintegradosweb.com)
CONTACT_EMAIL_TO=antonioa@serviciosintegradosweb.com

# Nombre y remitente que figura en el email enviado (opcional)
CONTACT_EMAIL_FROM="Servicios Integrados Web" <antonioa@serviciosintegradosweb.com>

# -----------------------------------------------------------------------------
# ASISTENTE IA (solo servidor — NUNCA usar prefijo VITE_, se publicaría en el navegador)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# SUPABASE / PANEL DE NOVEDADES
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mínimo 10 caracteres. Sin esta variable el endpoint /api/admin-novedades queda deshabilitado.
ADMIN_PASSWORD=
